{
  "name": "@vue-calendar/core",
  "version": "0.1.1",
  "description": "A modern, extensible Vue 3 calendar component with TypeScript support",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "vue",
    "vue3",
    "calendar",
    "scheduler",
    "resource-scheduler",
    "drag-and-drop",
    "event-calendar",
    "week-view",
    "month-view",
    "day-view",
    "typescript"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && vue-tsc --emitDeclarationOnly",
    "build:lib": "vite build --mode lib",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\"",
    "build:demo": "vite build --mode demo"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.4.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "jiti": "^2.6.1",
    "prettier": "^3.5.0",
    "typescript": "~7.0.2",
    "vite": "8.3.5",
    "vite-plugin-css-injected-by-js": "^5.0.3",
    "vite-plugin-dts": "^5.1.2",
    "vue": "^3.5.0",
    "vue-tsc": "^3.3.14"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/petritr/vue-calendar.git"
  },
  "homepage": "https://petritr.github.io/vue-calendar/",
  "license": "MIT",
  "dependencies": {
    "temporal-polyfill": "^1.0.6"
  }
}
